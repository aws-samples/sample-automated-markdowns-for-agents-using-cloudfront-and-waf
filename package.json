{
  "name": "sample-automated-markdowns-for-agents-using-cloudfront-and-waf",
  "version": "1.0.0",
  "description": "AWS CDK sample: serve AI-agent-optimized markdown via Amazon CloudFront + AWS WAF",
  "bin": {
    "app": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "postinstall": "npm ci --prefix functions/signal --no-audit --no-fund",
    "cdk": "cdk",
    "nag": "cdk synth && echo '\nNag report: cdk.out/AwsSolutions-MarkdownGenerationStack-NagReport.csv'"
  },
  "devDependencies": {
    "@types/node": "^24",
    "aws-cdk": "2.1148.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1005.0",
    "@aws-sdk/signature-v4a": "^3.1003.0",
    "aws-cdk-lib": "2.277.0",
    "cdk-nag": "^2.37.55",
    "constructs": "^10.5.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "license": "MIT-0"
}
